# Copy to .env to override docker-compose defaults

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=financialdb
SECRET_KEY=change-me-in-production

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Fill the DB with demo users on start (alice@example.com / password123)
SEED_DATA=true

# Optional: OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
