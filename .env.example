# Copy to .env to override docker-compose defaults

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=financialdb
# production: refuses to start with placeholder / short (< 32 chars) secrets and disables /api/dev
APP_ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Signs the OAuth session cookie; empty = derived from SECRET_KEY
SESSION_SECRET=
# Passkeys (WebAuthn): the site's domain without scheme/port, e.g. finance.example.com.
# Changing it later makes existing passkeys unusable.
WEBAUTHN_RP_ID=localhost

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Fill the DB with demo users on start (alice@example.com / password123)
SEED_DATA=true

# Optional: OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
