{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .venv\\Scripts\\python.exe -m uvicorn src.app:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend-backend8001",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_BACKEND_URL=http://127.0.0.1:8001&& npm --prefix frontend run dev -- --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}